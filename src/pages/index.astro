---
/**
 * Home. Seções na ordem do sitemap (ARQUITETURA.md §6); entram uma a uma na Fase 1.
 * noindex até o lançamento (Fase 6).
 */
import Base from "../layouts/Base.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/secoes/Hero.astro";
import Resultados from "../components/secoes/Resultados.astro";
import Depoimentos from "../components/secoes/Depoimentos.astro";
import Metodo from "../components/secoes/Metodo.astro";
import Sobre from "../components/secoes/Sobre.astro";
import Nichos from "../components/secoes/Nichos.astro";
import Cta from "../components/secoes/Cta.astro";
import ParaQuem from "../components/secoes/ParaQuem.astro";
import Faq from "../components/secoes/Faq.astro";
---

<Base noindex>
  <Header />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Resultados />
    <Depoimentos />
    <Metodo />
    <Nichos />
    <Cta />
    <ParaQuem />
    <Faq />
  </main>
  <Footer />
</Base>
