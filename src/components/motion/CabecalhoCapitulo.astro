---
/**
 * Cabeçalho de capítulo do vídeo (MOTION.md §1.3): ● RÓTULO ——— 01 / 02.
 * Recebe todos os rótulos; o ativo é trocado pela animação (corte seco). Sem JS, mostra o primeiro.
 */
interface Props {
  rotulos: readonly string[];
}
const { rotulos } = Astro.props;
const dois = (n: number) => String(n).padStart(2, "0");
---

<div class="capitulo" data-capitulo aria-hidden="true">
  <span class="capitulo__ponto"></span>
  <span class="capitulo__pilha">
    {rotulos.map((r, i) => (
      <span data-capitulo-rotulo={i}>{r}</span>
    ))}
  </span>
  <span class="capitulo__trilho">
    <span class="capitulo__progresso" data-capitulo-progresso></span>
  </span>
  <span class="capitulo__contador">
    <span class="capitulo__pilha">
      {rotulos.map((_, i) => (
        <span data-capitulo-num={i}>{dois(i + 1)}</span>
      ))}
    </span>
    / {dois(rotulos.length)}
  </span>
</div>

<style>
  .capitulo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto);
  }
  .capitulo__ponto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lima);
    box-shadow: 0 0 10px var(--lima);
  }
  /* rótulos empilhados no mesmo lugar; só o primeiro aparece sem JS */
  .capitulo__pilha {
    display: inline-grid;
  }
  .capitulo__pilha > * {
    grid-area: 1 / 1;
  }
  .capitulo__pilha > :not(:first-child) {
    opacity: 0;
  }
  .capitulo__trilho {
    flex: 1;
    height: 1px;
    background: rgb(255 255 255 / 0.12);
    position: relative;
  }
  .capitulo__progresso {
    position: absolute;
    inset: 0;
    background: var(--lima);
    transform-origin: 0 50%;
    transform: scaleX(0.5);
  }
  .capitulo__contador {
    display: inline-flex;
    gap: 0.4em;
    color: var(--texto-2);
  }
</style>
