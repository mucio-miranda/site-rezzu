---
/**
 * Cena "Capítulo 02 · Faturamento" do vídeo institucional (MOTION.md §1.3), em SVG.
 * Barras 3D lima sobem uma a uma → linha com seta se desenha pelos topos → pílulas TESTE passam
 * de vazias (contorno) a validadas (lima + ✔) → moedas caem na carteira "R$" com brilhos.
 * Mesma convenção da CenaPosicionamento: peça animável = <g data-fat="..."> interno, sem transform próprio.
 * Sem números inventados: é ilustração de crescimento, sem eixo nem valores. Animação: src/scripts/anim-hero.ts.
 */
interface Props {
  /** pílula ✔ do capítulo, como a "Posicionamento" do capítulo 01 */
  rotulo: string;
  testes: readonly string[];
  moeda: string;
}
const { rotulo, testes, moeda } = Astro.props;

// barras em pseudo-3D: frente + lateral + topo; base comum em y = 470
const BASE = 470;
const L = 56; // largura da frente
const P = { x: 18, y: -12 }; // profundidade (deslocamento da face de trás)
const barras = [92, 150, 214, 280].map((h, i) => {
  const x = 236 + i * 80;
  const t = BASE - h;
  return {
    x,
    frente: `M${x} ${t}h${L}v${h}h${-L}z`,
    lado: `M${x + L} ${t}l${P.x} ${P.y}v${h}l${-P.x} ${-P.y}z`,
    topo: `M${x} ${t}l${P.x} ${P.y}h${L}l${-P.x} ${-P.y}z`,
  };
});

// pílulas TESTE (coluna da esquerda) e moedas
const pilulas = testes.map((rotulo, i) => ({ rotulo, y: 140 + i * 46 }));
const moedas = [82, 114, 146];
const brilhos = [
  { x: 206, y: 378, s: 1 },
  { x: 28, y: 392, s: 0.7 },
  { x: 196, y: 520, s: 0.8 },
];
---

<div class="cena" data-cap="1" aria-hidden="true">
  <svg class="cena__camada" viewBox="0 0 640 620">
    <!-- chão das barras -->
    <g class="neon" stroke="var(--lima)" fill="none">
      <path data-fat="chao" d="M212 470h360" stroke-width="2" opacity="0.5"></path>
    </g>

    <!-- barras -->
    <g class="neon">
      {barras.map((b) => (
        <g data-fat="barra" data-base-x={b.x + L / 2}>
          <path d={b.lado} fill="#5d7409" />
          <path d={b.frente} fill="var(--lima)" />
          <path d={b.topo} fill="var(--lima-luz)" />
        </g>
      ))}
    </g>

    <!-- linha com seta pelos topos -->
    <g
      class="neon"
      fill="none"
      stroke="var(--branco)"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path data-fat="seta" d="M206 358L264 338L300 352L344 278L380 294L424 214L462 228L548 104"></path>
    </g>
    <g transform="translate(554 96) rotate(-52)">
      <g data-fat="seta-ponta" class="neon">
        <path d="M2 0L-16 -10L-16 10z" fill="var(--branco)"></path>
      </g>
    </g>

    <!-- pílula do capítulo: ✔ FATURAMENTO (par da "Posicionamento" do capítulo 01) -->
    <g transform="translate(286 40)">
      <g data-fat="pilula">
        <rect width="134" height="30" rx="15" fill="var(--lima)"></rect>
        <circle cx="16" cy="15" r="8" fill="none" stroke="#030303" stroke-width="2"></circle>
        <path
          d="M12.5 15.2l2.4 2.4 4.6-4.8"
          fill="none"
          stroke="#030303"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
        <text x="32" y="19.5" class="cena__txt cena__txt--escuro">
          {rotulo}
        </text>
      </g>
    </g>

    <!-- pílulas TESTE: vazia → validada -->
    {pilulas.map((p) => (
      <g transform={`translate(40 ${p.y})`}>
        <g data-fat="teste">
          <rect width="132" height="32" rx="16" fill="#030303" stroke="var(--lima)" stroke-width="1.5" />
          <circle cx="17" cy="16" r="7.5" fill="none" stroke="var(--lima)" stroke-width="1.5" />
          <text x="34" y="20.5" class="cena__txt">
            {p.rotulo}
          </text>
          <g data-fat="teste-ok">
            <rect width="132" height="32" rx="16" fill="var(--lima)" />
            <circle cx="17" cy="16" r="7.5" fill="none" stroke="#030303" stroke-width="2" />
            <path
              d="M13.5 16.2l2.4 2.4 4.6-4.8"
              fill="none"
              stroke="#030303"
              stroke-width="2"
              stroke-linecap="round"
            />
            <text x="34" y="20.5" class="cena__txt cena__txt--escuro">
              {p.rotulo}
            </text>
          </g>
        </g>
      </g>
    ))}

    <!-- moedas (atrás da carteira: caem para dentro dela) -->
    {moedas.map((x) => (
      <g transform={`translate(${x} 436)`}>
        <g data-fat="moeda" class="neon">
          <circle r="14" fill="var(--lima)" />
          <circle r="8.5" fill="none" stroke="#030303" stroke-width="1.5" opacity="0.55" />
        </g>
      </g>
    ))}

    <!-- carteira R$ -->
    <g transform="translate(115 452)">
      <g data-fat="carteira">
        <g class="neon">
          <rect
            x="-75"
            y="-48"
            width="150"
            height="96"
            rx="14"
            fill="#060801"
            stroke="var(--lima)"
            stroke-width="2"
          ></rect>
        </g>
        <path d="M-75 -22h150" stroke="var(--lima)" stroke-width="1.5" opacity="0.35"></path>
        <rect
          x="40"
          y="-8"
          width="35"
          height="26"
          rx="7"
          fill="none"
          stroke="var(--lima)"
          stroke-width="1.5"
        ></rect>
        <circle cx="52" cy="5" r="3.5" fill="var(--lima)"></circle>
        <text x="-14" y="30" text-anchor="middle" class="cena__moeda">
          {moeda}
        </text>
      </g>
    </g>

    <!-- brilhos -->
    {brilhos.map((b) => (
      <g transform={`translate(${b.x} ${b.y}) scale(${b.s})`}>
        <g data-fat="brilho" class="neon">
          <path d="M0 -10L2.2 -2.2L10 0L2.2 2.2L0 10L-2.2 2.2L-10 0L-2.2 -2.2z" fill="var(--lima-luz)" />
        </g>
      </g>
    ))}
  </svg>
</div>

<style>
  .cena {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 620;
  }
  .cena__camada {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .neon {
    filter: var(--brilho);
  }
  .cena__txt {
    font-family: var(--f-texto);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--lima);
  }
  .cena__txt--escuro {
    fill: #030303;
  }
  .cena__moeda {
    font-family: var(--f-display);
    font-size: 44px;
    fill: var(--lima);
  }
</style>
