---
/**
 * Cena "Capítulo 01 · Posicionamento" do vídeo institucional (MOTION.md §1.3), em SVG.
 * Camadas: fundo (radar, mira, onda do pin, ícones em órbita) → celular neon (inclinado em 3D via CSS) → frente (pin, pílulas).
 * Cada peça animável é um <g data-cena="..."> interno, sem transform próprio (o posicionamento fica no <g> de fora),
 * para a animação poder mexer em x/y/escala sem desmontar a cena. Sem JS, aparece montada.
 * Animação: src/scripts/anim-hero.ts.
 */
interface Props {
  posicao: string;
  publico: string;
  local: string;
}
const { posicao, publico, local } = Astro.props;

// grade do feed 3x3: opacidades variadas, como no vídeo
const opac = [1, 0.45, 0.8, 0.6, 1, 0.35, 0.9, 0.55, 1];
const celulas = opac.map((o, i) => ({ x: 28 + (i % 3) * 64, y: 124 + Math.floor(i / 3) * 64, o }));

// ícones em órbita no anel do radar (centro 320,320 · raio 244); ângulo inicial em graus (0 = direita, sentido horário)
// (o mesmo centro/raio está em anim-hero.ts, que gira os ícones)
const ORBITA = { cx: 320, cy: 320, r: 244 };
const icones = [
  { nome: "play", angulo: -38 },
  { nome: "coracao", angulo: 196 },
  { nome: "chat", angulo: 152 },
  { nome: "pessoa", angulo: 108 },
].map((i) => {
  const a = (i.angulo * Math.PI) / 180;
  return { ...i, x: ORBITA.cx + ORBITA.r * Math.cos(a) - 22, y: ORBITA.cy + ORBITA.r * Math.sin(a) - 22 };
});
---

<div class="cena" data-cap="0" aria-hidden="true">
  <!-- fundo: radar, mira, onda do pin -->
  <svg class="cena__camada" viewBox="0 0 640 620">
    <g class="neon" fill="none" stroke="var(--lima)">
      <circle data-cena="radar" cx="320" cy="320" r="214" stroke-width="2" opacity="0.6"></circle>
      <circle
        data-cena="radar-anel"
        cx="320"
        cy="320"
        r="244"
        stroke-width="2"
        opacity="0.35"
        stroke-dasharray="150 46"
      ></circle>
      <g data-cena="mira" stroke-width="2" opacity="0.7">
        <path d="M86 320h26M528 320h26M320 66v26M320 548v26"></path>
      </g>
    </g>
    <g transform="translate(520 418)">
      <g data-cena="pin-onda">
        <ellipse rx="46" ry="11" fill="none" stroke="var(--lima)" stroke-width="2" opacity="0.6"></ellipse>
      </g>
    </g>

    <!-- ícones em órbita no anel (atrás do celular, do pin e das pílulas: dá profundidade) -->
    {icones.map((i) => (
      <g data-cena="orbita" data-angulo={i.angulo} transform={`translate(${i.x} ${i.y})`}>
        <g data-cena="icone">
          <rect width="44" height="44" rx="10" fill="#0a0d02" stroke="var(--lima)" stroke-width="1.5" />
          {i.nome === "play" && <path d="M18 14l12 8-12 8z" fill="var(--lima)" />}
          {i.nome === "coracao" && (
            <path
              d="M22 32s-10-6-10-12a5.5 5.5 0 0 1 10-3 5.5 5.5 0 0 1 10 3c0 6-10 12-10 12z"
              fill="var(--lima)"
            />
          )}
          {i.nome === "chat" && (
            <path
              d="M12 14h20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H20l-6 5v-5h-2a2 2 0 0 1-2-2V16a2 2 0 0 1 2-2z"
              fill="var(--lima)"
            />
          )}
          {i.nome === "pessoa" && (
            <>
              <circle cx="22" cy="17" r="5.5" fill="var(--lima)" />
              <path d="M12 33c2-6 18-6 20 0" fill="var(--lima)" />
            </>
          )}
        </g>
      </g>
    ))}
  </svg>

  <!-- celular (inclinado em 3D pelo CSS) -->
  <div class="cena__celular">
    <svg viewBox="0 0 240 460" class="neon">
      <rect
        data-cena="celular"
        x="4"
        y="4"
        width="232"
        height="452"
        rx="30"
        fill="rgb(168 204 21 / 0.035)"
        stroke="var(--lima)"
        stroke-width="2.5"
      ></rect>
      <rect x="95" y="16" width="50" height="5" rx="2.5" fill="var(--lima)" opacity="0.5"></rect>
      <g data-cena="perfil">
        <circle
          cx="46"
          cy="66"
          r="18"
          fill="rgb(168 204 21 / 0.15)"
          stroke="var(--lima)"
          stroke-width="2"
        ></circle>
        <rect x="76" y="54" width="90" height="7" rx="3.5" fill="var(--lima)"></rect>
        <rect x="76" y="70" width="56" height="5" rx="2.5" fill="var(--lima)" opacity="0.45"></rect>
      </g>
      <g data-cena="stats" fill="var(--lima)" opacity="0.4">
        <rect x="28" y="100" width="48" height="5" rx="2.5"></rect>
        <rect x="96" y="100" width="48" height="5" rx="2.5"></rect>
        <rect x="164" y="100" width="48" height="5" rx="2.5"></rect>
      </g>
      {celulas.map((c) => (
        <rect
          data-cena="celula"
          x={c.x}
          y={c.y}
          width="56"
          height="56"
          rx="4"
          fill="var(--lima)"
          opacity={c.o}
        />
      ))}
      <rect
        data-cena="post"
        x="28"
        y="324"
        width="184"
        height="58"
        rx="8"
        fill="none"
        stroke="var(--lima)"
        stroke-width="1.5"
        opacity="0.35"
      ></rect>
      <g fill="var(--lima)" opacity="0.4">
        <circle cx="70" cy="420" r="4"></circle>
        <circle cx="120" cy="420" r="4"></circle>
        <circle cx="170" cy="420" r="4"></circle>
      </g>
    </svg>
  </div>

  <!-- frente: pin e pílulas -->
  <svg class="cena__camada" viewBox="0 0 640 620">
    <g transform="translate(520 360)">
      <g data-cena="pin" class="neon">
        <path d="M0 52c-16-20-26-33-26-48a26 26 0 0 1 52 0c0 15-10 28-26 48z" fill="var(--lima)"></path>
        <circle cy="4" r="9" fill="#030303"></circle>
      </g>
    </g>

    <!-- pílula: ✔ POSICIONAMENTO -->
    <g transform="translate(404 104)">
      <g data-cena="pilula">
        <rect width="172" height="30" rx="15" fill="var(--lima)"></rect>
        <circle cx="16" cy="15" r="8" fill="none" stroke="#030303" stroke-width="2"></circle>
        <path
          d="M12.5 15.2l2.4 2.4 4.6-4.8"
          fill="none"
          stroke="#030303"
          stroke-width="2"
          stroke-linecap="round"
        ></path>
        <text x="32" y="19.5" class="cena__txt cena__txt--escuro">
          {posicao}
        </text>
      </g>
    </g>

    <!-- pílula: EMPRESÁRIO -->
    <g transform="translate(40 226)">
      <g data-cena="pilula">
        <rect width="150" height="30" rx="15" fill="#030303" stroke="var(--lima)" stroke-width="1.5"></rect>
        <circle cx="16" cy="12" r="4" fill="var(--lima)"></circle>
        <path d="M9 22c1.5-4 12.5-4 14 0" fill="var(--lima)"></path>
        <text x="32" y="19.5" class="cena__txt">
          {publico}
        </text>
      </g>
    </g>

    <!-- pílula: JOÃO PESSOA · PB -->
    <g transform="translate(436 440)">
      <g data-cena="pilula">
        <rect width="168" height="28" rx="14" fill="#030303" stroke="var(--lima)" stroke-width="1.5"></rect>
        <text x="84" y="18.5" text-anchor="middle" class="cena__txt">
          {local}
        </text>
      </g>
    </g>
  </svg>
</div>

<style>
  .cena {
    position: relative;
    width: 100%;
    aspect-ratio: 640 / 620;
  }
  .cena__camada {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .neon {
    filter: var(--brilho);
  }
  .cena__celular {
    position: absolute;
    left: 31.25%;
    top: 14.5%;
    width: 37.5%;
    transform: perspective(900px) rotateY(-18deg) rotateX(6deg);
    transform-origin: 50% 50%;
  }
  .cena__celular svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cena__txt {
    font-family: var(--f-texto);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--lima);
  }
  .cena__txt--escuro {
    fill: #030303;
  }
</style>
