---
/**
 * 01 · Hero (Impacto): a tese da REZZU em tipografia cinética (3 vozes) + cena do celular (capítulo 01).
 * Linguagem de motion: MOTION.md. Animação: src/scripts/anim-hero.ts.
 * Sem JS ou com "reduzir movimento", tudo aparece montado.
 */
import Botao from "../ui/Botao.astro";
import Sobretitulo from "../ui/Sobretitulo.astro";
import PisoGrade from "../motion/PisoGrade.astro";
import CenaPosicionamento from "../motion/CenaPosicionamento.astro";
import CenaFaturamento from "../motion/CenaFaturamento.astro";
import { hero } from "../../content/home";

const conectivo = hero.tese.conectivo.split(" ");
---

<section class="hero" data-hero aria-labelledby="hero-titulo">
  <PisoGrade horizonte={60} data-anim data-hero-piso />

  <div class="hero__grade container">
    <div class="hero__texto">
      <Sobretitulo fio={false} data-anim data-hero-fade>
        {hero.sobretitulo}
      </Sobretitulo>

      <h1 id="hero-titulo" class="tese">
        <span class="tese__linha">
          {conectivo.map((p) => (
            <span class="voz-conectivo" data-anim data-hero-batida>
              {p}
            </span>
          ))}
          <span class="voz-impacto" data-anim data-hero-pop>
            {hero.tese.impacto}
          </span>
        </span>
        <span class="tese__sentido voz-sentido" data-anim data-hero-pop>
          {hero.tese.sentido1}
        </span>
        <span class="tese__linha">
          <span class="voz-impacto" data-anim data-hero-batida>
            {hero.tese.ligacao}
          </span>
          <span class="tese__sentido voz-sentido" data-anim data-hero-pop>
            {hero.tese.sentido2}
          </span>
        </span>
      </h1>

      <p class="hero__apoio" data-anim data-hero-fade>
        {hero.apoio}
      </p>
      <div class="hero__ctas" data-anim data-hero-fade>
        <Botao href={hero.ctaPrimario.href} evento="clique_cta">
          {hero.ctaPrimario.rotulo}
        </Botao>
        <Botao href={hero.ctaSecundario.href} variante="secundario" seta="baixo">
          {hero.ctaSecundario.rotulo}
        </Botao>
      </div>
    </div>

    <!-- palco: capítulo 01 (celular) e 02 (barras) se alternando, como no vídeo -->
    <div class="hero__cena palco" data-anim data-hero-cena role="img" aria-label={hero.cena.descricao}>
      <div class="palco__cenas">
        <CenaPosicionamento {...hero.cena.posicionamento} />
        <CenaFaturamento {...hero.cena.faturamento} />
        <div class="palco__clarao" data-palco-clarao aria-hidden="true"></div>
      </div>
    </div>

    <!-- celular: vídeo institucional no lugar do palco (quadro no estilo dos cards de Resultados) -->
    <figure class="hero__video" data-hero-video>
      <figcaption class="video__cap">
        <span class="video__ponto" aria-hidden="true"></span>
        <span>{hero.video.rotulo}</span>
        <span class="video__trilho" aria-hidden="true"></span>
        <span class="video__duracao">{hero.video.duracao}</span>
      </figcaption>
      <div class="video__tela">
        <video
          src={hero.video.src}
          preload="none"
          playsinline
          aria-label={hero.video.descricao}
          data-video
        ></video>
        <button
          class="video__capa"
          type="button"
          data-video-play
          aria-label={`Reproduzir: ${hero.video.chamada}`}
        >
          <img src={hero.video.capa} alt="" width="540" height="960" loading="lazy" decoding="async" />
          <span class="video__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="video__chamada">{hero.video.chamada}</span>
        </button>
      </div>
    </figure>
  </div>
</section>

<script>
  import "../../scripts/anim-hero";

  // vídeo do celular: só carrega ao tocar no play (preload="none"); depois ficam os controles nativos
  const quadro = document.querySelector<HTMLElement>("[data-hero-video]");
  const video = quadro?.querySelector<HTMLVideoElement>("[data-video]");
  const capa = quadro?.querySelector<HTMLButtonElement>("[data-video-play]");
  if (video && capa) {
    capa.addEventListener("click", () => {
      capa.hidden = true;
      video.controls = true;
      void video.play();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* compacta: não estica até a tela toda em monitores altos */
    min-height: clamp(600px, 88svh, 820px);
    display: grid;
    align-items: center;
    padding-block: 104px 56px;
  }
  .hero > :global(.piso) {
    z-index: -1;
  }
  .hero__grade {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .hero__texto {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  /* tese em 3 vozes, toda em Bebas Neue e num tamanho só: a diferença é a cor (branco × lima) */
  .tese {
    display: grid;
    justify-items: start;
    color: var(--branco);
    font-size: var(--t-hero);
  }
  .tese > * > *,
  .tese > .tese__sentido {
    font-size: inherit;
    line-height: 0.92;
  }
  .tese__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.2em;
  }
  .tese__linha > span {
    display: inline-block;
  }
  .tese [data-hero-pop] {
    display: inline-block;
    transform-origin: 0 70%;
  }

  .hero__apoio {
    font-size: var(--t-apoio);
    line-height: 1.6;
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  /* palco: cenas empilhadas no mesmo lugar */
  .palco {
    display: grid;
    gap: clamp(8px, 2vh, 20px);
    width: 100%;
    max-width: 560px;
    justify-self: end;
  }
  .palco__cenas {
    position: relative;
    display: grid;
  }
  /* :global porque as cenas são outros componentes (o escopo do Astro não as alcança) */
  .palco__cenas > :global(*) {
    grid-area: 1 / 1;
  }
  /* sem JS, só o capítulo 01 aparece */
  .palco__cenas > :global([data-cap="1"]) {
    visibility: hidden;
  }
  /* clarão de troca de capítulo (como o film burn do vídeo) */
  .palco__clarao {
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      closest-side,
      rgb(200 240 58 / 0.55),
      rgb(168 204 21 / 0.12) 60%,
      transparent
    );
    mix-blend-mode: screen;
  }

  /* vídeo institucional: só no celular/tablet. Quadro igual ao card de Resultados */
  .hero__video {
    display: none;
    gap: 14px;
    width: 100%;
    max-width: 400px;
    justify-self: center;
    padding: 14px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 20px;
    background:
      radial-gradient(120% 70% at 50% 0%, rgb(168 204 21 / 0.07), transparent 70%), rgb(255 255 255 / 0.015);
  }
  .video__cap {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto);
  }
  .video__ponto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lima);
    box-shadow: 0 0 10px var(--lima);
  }
  .video__trilho {
    flex: 1;
    height: 1px;
    background: rgb(255 255 255 / 0.12);
  }
  .video__duracao {
    color: var(--texto-2);
    font-variant-numeric: tabular-nums;
  }
  .video__tela {
    position: relative;
    display: grid;
    aspect-ratio: 9 / 16;
    width: min(100%, 72svh * 9 / 16); /* largura fixa: não muda quando o vídeo carrega */
    margin-inline: auto;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }
  .video__tela > * {
    grid-area: 1 / 1;
  }
  .video__tela video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__capa {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
  }
  .video__capa[hidden] {
    display: none;
  }
  .video__capa img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__capa::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(3 3 3 / 0.85), transparent 45%);
  }
  .video__play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--lima);
    color: var(--bg);
    box-shadow: 0 0 0 8px rgb(168 204 21 / 0.18);
    transition: transform 0.25s var(--ease);
  }
  .video__capa:hover .video__play,
  .video__capa:focus-visible .video__play {
    transform: scale(1.06);
  }
  .video__chamada {
    position: absolute;
    z-index: 1;
    inset: auto 16px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--branco);
    text-align: center;
  }

  @media (max-width: 900px) {
    /* celular/tablet: sem o palco animado; entra o vídeo */
    .hero__cena {
      display: none;
    }
    .hero__video {
      display: grid;
    }
    .hero {
      min-height: auto;
      padding-block: 96px 48px;
    }
    .hero__grade {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .palco {
      max-width: 440px;
      justify-self: center;
    }
    /* celular: texto da hero centralizado */
    .hero__texto,
    .tese {
      justify-items: center;
      text-align: center;
    }
    .tese__linha,
    .hero__ctas {
      justify-content: center;
    }
    .tese [data-hero-pop] {
      transform-origin: 50% 70%;
    }
  }

  /* esconde o que vai animar SÓ quando o JS de animação está ativo (classe posta no <head>) */
  :global(.anim-espera) [data-anim] {
    opacity: 0;
  }
</style>
