---
/**
 * 01 · Hero (Impacto): a tese da REZZU em tipografia cinética (3 vozes) + foto dos fundadores (V2: veio do Sobre).
 * Foto: gerada com IA a partir da foto do ensaio (prompt em SITE/ASSETS/prompts-ia/fundadores-sobre.md), luz lima da
 * esquerda, recortada no Photoshop (Selecionar assunto). Atrás, o Z da marca em meio-tom.
 * Linguagem de motion: MOTION.md. Animação: src/scripts/anim-hero.ts (a foto sai do escuro e a luz se abre).
 * Sem JS ou com "reduzir movimento", tudo aparece montado.
 */
import { Image } from "astro:assets";
import Botao from "../ui/Botao.astro";
import Sobretitulo from "../ui/Sobretitulo.astro";
import PisoGrade from "../motion/PisoGrade.astro";
import foto from "../../assets/fundadores/fundadores-ia-v2.webp";
// PNG de 16 cores (59 KB): o meio-tom em pontos fica 3x mais leve que em WebP
import fundoZ from "../../assets/fundadores/fundo-z-meio-tom.png";
import { hero } from "../../content/home";

const conectivo = hero.tese.conectivo.split(" ");
---

<section class="hero" data-hero aria-labelledby="hero-titulo">
  <PisoGrade horizonte={60} data-anim data-hero-piso />
  <!-- luz lima vinda da esquerda: ocupa a seção toda e acompanha a largura da tela -->
  <span class="hero__luz" data-anim data-hero-luz aria-hidden="true"></span>

  <div class="hero__grade container">
    <div class="hero__texto">
      <Sobretitulo fio={false} data-anim data-hero-fade>
        {hero.sobretitulo}
      </Sobretitulo>

      <h1 id="hero-titulo" class="tese">
        <span class="tese__linha">
          {conectivo.map((p) => (
            <span class="voz-conectivo" data-anim data-hero-batida>
              {p}
            </span>
          ))}
          <span class="voz-impacto" data-anim data-hero-pop>
            {hero.tese.impacto}
          </span>
        </span>
        <span class="tese__sentido voz-sentido" data-anim data-hero-pop>
          {hero.tese.sentido1}
        </span>
        <span class="tese__linha">
          <span class="voz-impacto" data-anim data-hero-batida>
            {hero.tese.ligacao}
          </span>
          <span class="tese__sentido voz-sentido" data-anim data-hero-pop>
            {hero.tese.sentido2}
          </span>
        </span>
      </h1>

      <p class="hero__apoio" data-anim data-hero-fade>
        {hero.apoio}
      </p>
      <div class="hero__ctas" data-anim data-hero-fade>
        <Botao href={hero.ctaPrimario.href} evento="clique_cta">
          {hero.ctaPrimario.rotulo}
        </Botao>
      </div>
    </div>

    <figure class="hero__foto" data-hero-foto>
      <!-- fundo de baixa opacidade: o Z da marca em meio-tom, atrás dos fundadores -->
      <img
        class="hero__fundo"
        src={fundoZ.src}
        width={fundoZ.width}
        height={fundoZ.height}
        alt=""
        decoding="async"
        data-anim
        data-hero-fundo
      />
      <div class="hero__img" data-anim data-hero-img>
        <Image
          src={foto}
          alt={hero.altFoto}
          widths={[420, 640, 900, 1024]}
          sizes="(max-width: 900px) 92vw, 480px"
          loading="eager"
          fetchpriority="high"
          quality={78}
        />
      </div>
    </figure>
  </div>
</section>

<script>
  import "../../scripts/anim-hero";
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    /* compacta: não estica até a tela toda em monitores altos */
    --altura: clamp(600px, 88svh, 820px);
    min-height: var(--altura);
    display: grid;
    align-items: center;
    padding-block: 104px 56px;
  }
  .hero > :global(.piso) {
    z-index: -1;
  }
  .hero__grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }
  .hero__texto {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  /* tese em 3 vozes, toda em Bebas Neue e num tamanho só: a diferença é a cor (branco × lima) */
  .tese {
    display: grid;
    justify-items: start;
    color: var(--branco);
    font-size: var(--t-hero);
  }
  .tese > * > *,
  .tese > .tese__sentido {
    font-size: inherit;
    line-height: 0.92;
  }
  .tese__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.2em;
  }
  .tese__linha > span {
    display: inline-block;
  }
  .tese [data-hero-pop] {
    display: inline-block;
    transform-origin: 0 70%;
  }

  .hero__apoio {
    font-size: var(--t-apoio);
    line-height: 1.6;
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* luz lima (cor da marca) vindo da borda esquerda da tela: tamanho em vw para escalar do notebook ao
     ultrawide, e some suave em todas as direções (sem corte na borda da seção nem da foto) */
  .hero__luz {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse min(62vw, 1100px) 70% at 0% 46%,
        rgb(168 204 21 / 0.2),
        rgb(168 204 21 / 0.07) 45%,
        transparent 75%
      ),
      radial-gradient(ellipse min(30vw, 520px) 40% at 0% 42%, rgb(168 204 21 / 0.16), transparent 70%);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    transform-origin: 0 46%;
  }

  /* foto do tamanho da hero: as cabeças logo abaixo do menu e as pernas somem no pé com o degradê
     (a foto passa um pouco das bordas de cima e de baixo, onde já está transparente). As margens negativas
     somam a sobra (1,5x − 1x a altura + os paddings): a foto não estica a hero nem empurra o texto */
  .hero__foto {
    --desloca: 40px;
    position: relative;
    margin: calc(-104px - var(--altura) * 0.122) 0 calc(-56px - var(--altura) * 0.383);
    align-self: end;
    display: grid;
    justify-items: center;
  }
  /* Z da marca em meio-tom, atrás dos fundadores, do tamanho da foto */
  .hero__fundo {
    position: absolute;
    left: calc(50% - var(--desloca));
    top: 48%;
    width: auto;
    height: 96%;
    max-width: none;
    translate: -50% -50%;
    opacity: 0.2;
    pointer-events: none;
    /* bordas somem: sem o retângulo de pontos aparente */
    mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
  }
  .hero__img {
    position: relative;
    /* a altura da hero manda: a foto (2:3) fica com ~1,5x a altura dela (cabeças a ~14% do topo); invade o vão da
       grade e anda um pouco para a esquerda (--desloca), sem chegar no texto */
    width: min(calc(var(--altura) * 1.003), 100% + 200px);
    max-width: none;
    left: calc(var(--desloca) * -1);
    mask-image: linear-gradient(to bottom, #000 56%, transparent 74%); /* some antes do pé da hero */
  }
  .hero__img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* notebook pequeno/tablet: a coluna da foto volta a ser a menor, senão o título quebra em mais linhas */
  @media (max-width: 1180px) {
    .hero__grade {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
    /* menos espaço ao lado: a foto não invade tanto nem anda para a esquerda (o texto está mais perto) */
    .hero__foto {
      --desloca: 0px;
    }
    .hero__img {
      width: min(calc(var(--altura) * 1.003), 100% + 96px);
    }
  }
  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-block: 96px 48px;
    }
    .hero__grade {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero__foto {
      margin: 0 0 -48px;
    }
    .hero__img {
      width: min(92%, 440px);
    }
    /* celular: texto da hero centralizado */
    .hero__texto,
    .tese {
      justify-items: center;
      text-align: center;
    }
    .tese__linha,
    .hero__ctas {
      justify-content: center;
    }
    .tese [data-hero-pop] {
      transform-origin: 50% 70%;
    }
  }

  /* esconde o que vai animar SÓ quando o JS de animação está ativo (classe posta no <head>) */
  :global(.anim-espera) [data-anim] {
    opacity: 0;
  }
</style>
