---
/**
 * 09 · FAQ: objeções antes de agendar. Esquerda: título + apoio + CTA; direita: acordeão.
 * Acordeão nativo (<details name>): abre um por vez, funciona sem JS e é acessível por teclado.
 * A abertura anima com ::details-content (navegadores novos); nos outros, abre direto.
 * Os mesmos textos viram dados estruturados FAQPage (resultado rico no Google).
 * Animação de entrada: src/scripts/anim-faq.ts.
 */
import CabecalhoSecao from "../ui/CabecalhoSecao.astro";
import Botao from "../ui/Botao.astro";
import { faq, ctaPrincipal } from "../../content/home";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.perguntas.map((p) => ({
    "@type": "Question",
    name: p.pergunta,
    acceptedAnswer: { "@type": "Answer", text: p.resposta },
  })),
};
---

<section id="faq" class="faq" data-faq aria-labelledby="faq-titulo">
  <div class="faq__grade container">
    <div class="faq__texto">
      <CabecalhoSecao id="faq-titulo" sobretitulo={faq.sobretitulo} {...faq.titulo} />
      <p class="faq__apoio" data-faq-apoio>{faq.apoio}</p>
      <div data-faq-apoio>
        <Botao href={ctaPrincipal.href} evento="clique_cta">
          {faq.botao}
        </Botao>
      </div>
    </div>

    <div class="faq__lista">
      {faq.perguntas.map((p, i) => (
        <details class="faq-item" name="faq" data-faq-item open={i === 0}>
          <summary class="faq-item__pergunta">
            <span class="faq-item__mais" aria-hidden="true" />
            <span>{p.pergunta}</span>
          </summary>
          <p class="faq-item__resposta">{p.resposta}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</section>

<script>
  import "../../scripts/anim-faq";
</script>

<style>
  .faq {
    position: relative;
    padding-block: var(--secao-respiro) calc(var(--secao-respiro) * 1.3);
  }
  .faq__grade {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(36px, 6vw, 96px);
  }
  .faq__texto {
    position: sticky;
    top: 120px;
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .faq__texto :global(.cabecalho) {
    margin-bottom: -4px;
  }
  .faq__apoio {
    max-width: 40ch;
    font-size: var(--t-apoio);
    line-height: 1.6;
    color: var(--texto);
  }
  .faq__lista {
    display: grid;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.025);
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
    interpolate-size: allow-keywords;
  }
  .faq-item:hover {
    border-color: rgb(255 255 255 / 0.16);
  }
  .faq-item[open] {
    border-color: rgb(168 204 21 / 0.35);
    background: linear-gradient(160deg, rgb(168 204 21 / 0.06), rgb(255 255 255 / 0.02) 60%);
  }
  /* abertura suave onde o navegador suporta (Chrome/Edge 131+) */
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.35s var(--ease),
      content-visibility 0.35s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }
  .faq-item__pergunta {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--branco);
    cursor: pointer;
    list-style: none;
    border-radius: 16px;
  }
  .faq-item__pergunta::-webkit-details-marker {
    display: none;
  }
  .faq-item__pergunta:focus-visible {
    outline: 2px solid var(--lima);
    outline-offset: 2px;
  }
  /* "+" que gira e vira "×" ao abrir */
  .faq-item__mais {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    transition:
      rotate 0.35s var(--ease),
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .faq-item__mais::before,
  .faq-item__mais::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 1.6px;
    border-radius: 2px;
    background: var(--texto);
    transition: background-color 0.3s var(--ease);
  }
  .faq-item__mais::after {
    rotate: 90deg;
  }
  .faq-item[open] .faq-item__mais {
    rotate: 45deg;
    border-color: transparent;
    background: var(--lima);
  }
  .faq-item[open] .faq-item__mais::before,
  .faq-item[open] .faq-item__mais::after {
    background: var(--bg);
  }
  .faq-item__resposta {
    padding: 0 22px 22px 66px;
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--texto);
  }
  @media (max-width: 900px) {
    .faq__grade {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq__texto {
      position: static;
    }
  }
  @media (max-width: 480px) {
    .faq-item__pergunta {
      padding: 18px;
      gap: 14px;
      font-size: 1rem;
    }
    .faq-item__resposta {
      padding: 0 18px 20px;
      font-size: 0.9375rem;
    }
  }
</style>
