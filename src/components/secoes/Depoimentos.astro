---
/**
 * 03 · Depoimentos: prova social com rosto. Cada card conta antes → virada → resultado e anima
 * do P&B para a cor, como a dor × solução do vídeo (MOTION.md §1.4). Desktop: 3 colunas;
 * celular: carrossel com arraste (scroll-snap nativo). Animação: src/scripts/anim-depoimentos.ts.
 * Conteúdo em src/content/depoimentos.ts: depoimentos reais (vídeos do @rezzugroup), com link para o vídeo.
 */
import { Image } from "astro:assets";
import CabecalhoSecao from "../ui/CabecalhoSecao.astro";
import { depoimentos, depoimentosCabecalho } from "../../content/depoimentos";

// código do Reel (instagram.com/reel/CODIGO/...) para montar o player embutido
const codigoReel = (url: string) => url.match(/\/(?:reel|p)\/([\w-]+)/)?.[1] ?? "";

const iniciais = (nome: string) =>
  nome
    .split(" ")
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0].toUpperCase())
    .join("");
---

<section id="depoimentos" class="depoimentos" data-depoimentos aria-labelledby="depoimentos-titulo">
  <div class="container">
    <CabecalhoSecao
      id="depoimentos-titulo"
      sobretitulo={depoimentosCabecalho.sobretitulo}
      {...depoimentosCabecalho.titulo}
    />
  </div>

  <ul class="depoimentos__lista container" role="list">
    {depoimentos.map((d) => (
      <li class="dep" data-dep>
        <figure class="dep__corpo">
          <div class="dep__topo" aria-hidden="true">
            <span class="dep__aspas" data-dep-aspas>
              “
            </span>
            <span class="dep__selo">{d.selo}</span>
          </div>
          <blockquote class="dep__texto">
            <p>
              <span class="dep__antes" data-dep-parte>
                {d.antes}
              </span>{" "}
              <span class="dep__virada" data-dep-parte>
                {d.virada}
              </span>{" "}
              <span class="dep__resultado" data-dep-parte data-dep-resultado>
                {d.resultado}
              </span>
            </p>
          </blockquote>
          <figcaption class="dep__pessoa" data-dep-pessoa>
            {d.foto ? (
              <Image src={d.foto} alt="" width={104} height={104} class="dep__foto" />
            ) : (
              <span class="dep__foto dep__foto--iniciais" aria-hidden="true">
                {iniciais(d.nome) || "?"}
              </span>
            )}
            <span class="dep__quem">
              <span class="dep__nome">{d.nome}</span>
              <span class="dep__negocio">{d.negocio}</span>
            </span>
            {d.video && (
              <a
                class="dep__video"
                href={d.video}
                data-dep-video={codigoReel(d.video)}
                data-dep-nome={d.nome}
                aria-haspopup="dialog"
                aria-label={`Assistir ao depoimento de ${d.nome}`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 7.5v9l7-4.5z" fill="currentColor" />
                </svg>
              </a>
            )}
          </figcaption>
          {d.provisorio && <span class="dep__provisorio">Provisório · trocar pelo real</span>}
        </figure>
      </li>
    ))}
  </ul>

  <!-- modal do vídeo: o player do Instagram só carrega ao clicar no play (sem peso nem cookies antes) -->
  <dialog class="video-modal" data-video-modal aria-label="Depoimento em vídeo">
    <div class="video-modal__caixa">
      <div class="video-modal__topo">
        <p class="video-modal__nome" data-video-modal-nome></p>
        <button class="video-modal__fechar" type="button" data-video-modal-fechar aria-label="Fechar vídeo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6 6l12 12M18 6 6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
      <div class="video-modal__tela" data-video-modal-tela>
        <span class="video-modal__carregando" aria-hidden="true"></span>
      </div>
    </div>
  </dialog>
</section>

<script>
  import "../../scripts/anim-depoimentos";

  // modal do vídeo: abre o Reel do Instagram embutido (iframe /embed) dentro do nosso estilo
  const modal = document.querySelector<HTMLDialogElement>("[data-video-modal]");
  const tela = modal?.querySelector<HTMLElement>("[data-video-modal-tela]");
  const nome = modal?.querySelector<HTMLElement>("[data-video-modal-nome]");
  if (modal && tela && nome) {
    const fechar = () => modal.close();
    document.querySelectorAll<HTMLAnchorElement>("[data-dep-video]").forEach((a) =>
      a.addEventListener("click", (e) => {
        const codigo = a.dataset.depVideo;
        if (!codigo || typeof modal.showModal !== "function") return; // sem suporte: segue o link normal
        e.preventDefault();
        nome.textContent = a.dataset.depNome ?? "";
        tela.querySelector("iframe")?.remove();
        tela.classList.remove("video-modal__tela--pronta");
        const f = document.createElement("iframe");
        f.src = `https://www.instagram.com/reel/${codigo}/embed/`;
        f.title = `Depoimento de ${a.dataset.depNome ?? ""}`;
        f.allow = "autoplay; encrypted-media; picture-in-picture";
        f.setAttribute("allowfullscreen", "");
        f.addEventListener("load", () => tela.classList.add("video-modal__tela--pronta"), { once: true });
        tela.append(f);
        modal.showModal();
      }),
    );
    modal.querySelector("[data-video-modal-fechar]")?.addEventListener("click", fechar);
    // clique fora da caixa fecha
    modal.addEventListener("click", (e) => {
      if (e.target === modal) fechar();
    });
    // ao fechar, remove o player (para o vídeo parar de tocar)
    modal.addEventListener("close", () => tela.querySelector("iframe")?.remove());
  }
</script>

<style>
  .depoimentos {
    position: relative;
    padding-block: var(--secao-respiro);
  }

  .depoimentos__lista {
    list-style: none;
    padding: 14px 0 0; /* espaço para o selo "provisório" que fica sobre a borda */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 24px);
  }

  .dep {
    display: flex;
  }
  .dep__corpo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: clamp(24px, 2.4vw, 36px);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 24px;
    background:
      radial-gradient(120% 60% at 0% 0%, rgb(168 204 21 / 0.06), transparent 70%), rgb(255 255 255 / 0.02);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  /* borda acende no hover (ARQUITETURA §6) */
  .dep__corpo:hover {
    border-color: rgb(168 204 21 / 0.55);
    box-shadow:
      0 0 0 1px rgb(168 204 21 / 0.15),
      0 0 32px rgb(168 204 21 / 0.12);
  }

  .dep__topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .dep__aspas {
    display: inline-block;
    font-family: var(--f-display);
    font-size: 5.5rem;
    line-height: 0.7;
    height: 0.5em;
    color: var(--lima);
    filter: var(--brilho);
  }
  .dep__selo {
    font-family: var(--f-display);
    font-size: 1.25rem;
    letter-spacing: 0.16em;
    color: var(--lima);
  }

  /* antes (dor, apagado) → virada → resultado (branco, sublinhado lima) */
  .dep__texto {
    margin: 0;
    flex: 1;
    font-size: var(--t-apoio);
    line-height: 1.6;
  }
  .dep__antes {
    color: var(--texto-2);
  }
  .dep__virada {
    color: var(--texto);
  }
  .dep__resultado {
    color: var(--branco);
    font-weight: 600;
    background: linear-gradient(var(--lima), var(--lima)) 0 100% / 100% 2px no-repeat;
    padding-bottom: 2px;
  }

  .dep__pessoa {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dep__foto {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--lima);
    object-fit: cover;
  }
  .dep__foto--iniciais {
    display: grid;
    place-items: center;
    background: #1a1a1a;
    color: var(--lima);
    font-weight: 700;
    font-size: 1rem;
  }
  .dep__quem {
    display: grid;
    gap: 2px;
  }
  .dep__nome {
    color: var(--branco);
    font-weight: 700;
  }
  .dep__negocio {
    font-size: 0.875rem;
    color: var(--texto-2);
  }

  /* aviso de conteúdo provisório: chamativo de propósito, para não ir ao ar assim */
  /* modal do vídeo (vidro escuro, no estilo do site) */
  .video-modal {
    width: min(92vw, 420px);
    max-height: 94svh;
    margin: auto; /* centraliza (o reset global zera a margem do <dialog>) */
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--branco);
    overflow: visible;
  }
  .video-modal::backdrop {
    background: rgb(3 3 3 / 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .video-modal[open] {
    animation: modal-entra 0.35s var(--ease);
  }
  @keyframes modal-entra {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  .video-modal__caixa {
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 24px;
    border: 1px solid rgb(168 204 21 / 0.35);
    background: linear-gradient(160deg, rgb(20 22 16 / 0.92), rgb(6 7 5 / 0.96));
    box-shadow:
      0 0 60px rgb(168 204 21 / 0.18),
      0 30px 80px rgb(0 0 0 / 0.6);
  }
  .video-modal__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-left: 6px;
  }
  .video-modal__nome {
    font-family: var(--f-display);
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .video-modal__fechar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    background: transparent;
    color: var(--branco);
    cursor: pointer;
  }
  .video-modal__fechar svg {
    width: 18px;
    height: 18px;
  }
  .video-modal__fechar:hover {
    border-color: var(--lima);
    color: var(--lima);
  }
  /* o embed do Instagram é claro e mostra curtidas e comentários (não dá para mudar o estilo de um iframe
     de outro site). A tela recorta o player e deixa à vista só o vídeo (largura × 1,25): o cabeçalho branco
     (54 px) sobe para fora e o rodapé fica escondido embaixo. Resultado: player escuro, sem curtidas. */
  .video-modal__tela {
    position: relative;
    display: block;
    aspect-ratio: 4 / 4.9; /* vídeo do Reel = largura × 1,25; um pouco menos para não vazar o rodapé branco */
    max-height: calc(94svh - 96px);
    border-radius: 16px;
    overflow: hidden;
    background: #000;
  }
  .video-modal__tela :global(iframe) {
    display: block;
    width: 100%;
    height: calc(100% + 420px);
    margin-top: -55px;
    border: 0;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .video-modal__tela--pronta :global(iframe) {
    opacity: 1;
  }
  .video-modal__carregando {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 3px solid rgb(168 204 21 / 0.25);
    border-top-color: var(--lima);
    animation: gira 0.8s linear infinite;
  }
  .video-modal__tela--pronta .video-modal__carregando {
    display: none;
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }

  .dep__video {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(168 204 21 / 0.45);
    color: var(--lima);
    flex: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .dep__video:hover,
  .dep__video:focus-visible {
    background: var(--lima);
    color: #050505;
  }
  .dep__video svg {
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }
  .dep__provisorio {
    position: absolute;
    top: -11px;
    left: 24px;
    padding: 2px 10px;
    border: 1px dashed #f5a524;
    border-radius: 999px;
    background: #1a1204;
    color: #f5a524;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* celular: carrossel com arraste (scroll-snap nativo, sem biblioteca) */
  @media (max-width: 900px) {
    .depoimentos__lista {
      display: flex;
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter);
      padding-block: 14px 8px;
      scrollbar-width: none;
    }
    .depoimentos__lista::-webkit-scrollbar {
      display: none;
    }
    .dep {
      flex: 0 0 min(86%, 380px);
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dep__corpo {
      transition: none;
    }
  }
</style>
