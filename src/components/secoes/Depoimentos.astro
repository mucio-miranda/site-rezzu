---
/**
 * 03 · Depoimentos: prova social com rosto. Cada card conta antes → virada → resultado e anima
 * do P&B para a cor, como a dor × solução do vídeo (MOTION.md §1.4). Desktop: 3 colunas;
 * celular: carrossel com arraste (scroll-snap nativo). Animação: src/scripts/anim-depoimentos.ts.
 * Conteúdo em src/content/depoimentos.ts: depoimentos reais (vídeos do @rezzugroup), com link para o vídeo.
 * Vídeos: baixados dos Reels e servidos pelo site (public/videos/depoimentos/<código>.mp4 + capa .webp),
 * tocados num player próprio, escuro, que só carrega ao clicar no play.
 */
import { Image } from "astro:assets";
import CabecalhoSecao from "../ui/CabecalhoSecao.astro";
import { depoimentos, depoimentosCabecalho } from "../../content/depoimentos";

// código do Reel (instagram.com/reel/CODIGO/...): é o nome do arquivo em public/videos/depoimentos/
const codigoReel = (url: string) => url.match(/\/(?:reel|p)\/([\w-]+)/)?.[1] ?? "";

const iniciais = (nome: string) =>
  nome
    .split(" ")
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0].toUpperCase())
    .join("");
---

<section id="depoimentos" class="depoimentos" data-depoimentos aria-labelledby="depoimentos-titulo">
  <div class="container">
    <CabecalhoSecao
      id="depoimentos-titulo"
      sobretitulo={depoimentosCabecalho.sobretitulo}
      {...depoimentosCabecalho.titulo}
    />
  </div>

  <ul class="depoimentos__lista container" role="list">
    {depoimentos.map((d) => (
      <li class="dep" data-dep>
        <figure class="dep__corpo">
          <div class="dep__topo" aria-hidden="true">
            <span class="dep__aspas" data-dep-aspas>
              “
            </span>
            <span class="dep__selo">{d.selo}</span>
          </div>
          <blockquote class="dep__texto">
            <p>
              <span class="dep__antes" data-dep-parte>
                {d.antes}
              </span>{" "}
              <span class="dep__virada" data-dep-parte>
                {d.virada}
              </span>{" "}
              <span class="dep__resultado" data-dep-parte data-dep-resultado>
                {d.resultado}
              </span>
            </p>
          </blockquote>
          <figcaption class="dep__pessoa" data-dep-pessoa>
            {d.foto ? (
              <Image src={d.foto} alt="" width={104} height={104} class="dep__foto" />
            ) : (
              <span class="dep__foto dep__foto--iniciais" aria-hidden="true">
                {iniciais(d.nome) || "?"}
              </span>
            )}
            <span class="dep__quem">
              <span class="dep__nome">{d.nome}</span>
              <span class="dep__negocio">{d.negocio}</span>
            </span>
            {d.video && (
              <a
                class="dep__video"
                href={d.video}
                data-dep-video={codigoReel(d.video)}
                data-dep-nome={d.nome}
                aria-haspopup="dialog"
                aria-label={`Assistir ao depoimento de ${d.nome}`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 7.5v9l7-4.5z" fill="currentColor" />
                </svg>
              </a>
            )}
          </figcaption>
          {d.provisorio && <span class="dep__provisorio">Provisório · trocar pelo real</span>}
        </figure>
      </li>
    ))}
  </ul>

  <!-- modal do vídeo: player próprio; o arquivo só carrega ao clicar no play -->
  <dialog class="video-modal" data-video-modal aria-label="Depoimento em vídeo">
    <div class="video-modal__caixa">
      <div class="video-modal__topo">
        <p class="video-modal__nome" data-video-modal-nome></p>
        <button class="video-modal__fechar" type="button" data-video-modal-fechar aria-label="Fechar vídeo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6 6l12 12M18 6 6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>
      <div class="video-modal__tela" data-video-modal-tela>
        <video class="video-modal__video" data-video playsinline preload="none"></video>
        <span class="video-modal__carregando" aria-hidden="true"></span>
        <button class="video-modal__play" type="button" data-video-play aria-label="Reproduzir">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13l10.5-6.5z" fill="currentColor" />
          </svg>
        </button>
        <div class="video-modal__controles">
          <!-- progresso em linhas horizontais: cada traço é um trecho do vídeo; clique ou arraste para pular -->
          <div
            class="video-modal__linhas"
            data-video-linhas
            role="slider"
            tabindex="0"
            aria-label="Posição do vídeo"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
          >
            {Array.from({ length: 20 }, () => <span />)}
          </div>
          <button class="video-modal__som" type="button" data-video-som aria-label="Desativar som">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
              <path
                class="video-modal__onda"
                d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
              <path
                class="video-modal__mudo"
                d="M16 9.5l5 5M21 9.5l-5 5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import "../../scripts/anim-depoimentos";

  // modal do vídeo: player próprio (vídeo baixado do Reel, servido pelo site)
  const modal = document.querySelector<HTMLDialogElement>("[data-video-modal]");
  const tela = modal?.querySelector<HTMLElement>("[data-video-modal-tela]");
  const nome = modal?.querySelector<HTMLElement>("[data-video-modal-nome]");
  const video = modal?.querySelector<HTMLVideoElement>("[data-video]");
  const linhas = modal?.querySelector<HTMLElement>("[data-video-linhas]");
  const som = modal?.querySelector<HTMLButtonElement>("[data-video-som]");
  if (modal && tela && nome && video && linhas && som) {
    const tracos = Array.from(linhas.children) as HTMLElement[];
    const fechar = () => modal.close();

    document.querySelectorAll<HTMLAnchorElement>("[data-dep-video]").forEach((a) =>
      a.addEventListener("click", (e) => {
        const codigo = a.dataset.depVideo;
        if (!codigo || typeof modal.showModal !== "function") return; // sem suporte: segue o link do Instagram
        e.preventDefault();
        nome.textContent = a.dataset.depNome ?? "";
        tela.classList.remove("video-modal__tela--pronta", "video-modal__tela--pausado");
        video.poster = `/videos/depoimentos/${codigo}.webp`;
        video.src = `/videos/depoimentos/${codigo}.mp4`;
        video.muted = false;
        modal.showModal();
        video.play().catch(() => tela.classList.add("video-modal__tela--pausado"));
      }),
    );

    // estado do player
    video.addEventListener("playing", () => tela.classList.add("video-modal__tela--pronta"));
    video.addEventListener("play", () => tela.classList.remove("video-modal__tela--pausado"));
    video.addEventListener("pause", () => tela.classList.add("video-modal__tela--pausado"));
    video.addEventListener("timeupdate", () => {
      const p = video.duration ? video.currentTime / video.duration : 0;
      const cheios = Math.round(p * tracos.length);
      tracos.forEach((t, i) => t.classList.toggle("cheio", i < cheios));
      linhas.setAttribute("aria-valuenow", String(Math.round(p * 100)));
    });
    video.addEventListener("volumechange", () => {
      tela.classList.toggle("video-modal__tela--mudo", video.muted);
      som.setAttribute("aria-label", video.muted ? "Ativar som" : "Desativar som");
    });

    // tocar/pausar: clique no vídeo ou no botão central
    const alternar = () => (video.paused ? video.play() : video.pause());
    video.addEventListener("click", alternar);
    modal.querySelector("[data-video-play]")?.addEventListener("click", alternar);
    som.addEventListener("click", () => (video.muted = !video.muted));

    // pular: clicar/arrastar nas linhas ou setas do teclado
    const pular = (x: number) => {
      const r = linhas.getBoundingClientRect();
      if (video.duration) video.currentTime = Math.min(Math.max((x - r.left) / r.width, 0), 0.999) * video.duration;
    };
    linhas.addEventListener("pointerdown", (e) => {
      linhas.setPointerCapture(e.pointerId);
      pular(e.clientX);
    });
    linhas.addEventListener("pointermove", (e) => {
      if (linhas.hasPointerCapture(e.pointerId)) pular(e.clientX);
    });
    linhas.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      video.currentTime += e.key === "ArrowRight" ? 5 : -5;
    });

    modal.querySelector("[data-video-modal-fechar]")?.addEventListener("click", fechar);
    // clique fora da caixa fecha
    modal.addEventListener("click", (e) => {
      if (e.target === modal) fechar();
    });
    // ao fechar, para o vídeo e solta o arquivo
    modal.addEventListener("close", () => {
      video.pause();
      video.removeAttribute("src");
      video.load();
      tracos.forEach((t) => t.classList.remove("cheio"));
    });
  }
</script>

<style>
  .depoimentos {
    position: relative;
    padding-block: var(--secao-respiro);
  }

  .depoimentos__lista {
    list-style: none;
    padding: 14px 0 0; /* espaço para o selo "provisório" que fica sobre a borda */
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.6vw, 24px);
  }

  .dep {
    display: flex;
  }
  .dep__corpo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    padding: clamp(24px, 2.4vw, 36px);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 24px;
    background:
      radial-gradient(120% 60% at 0% 0%, rgb(168 204 21 / 0.06), transparent 70%), rgb(255 255 255 / 0.02);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  /* borda acende no hover (ARQUITETURA §6) */
  .dep__corpo:hover {
    border-color: rgb(168 204 21 / 0.55);
    box-shadow:
      0 0 0 1px rgb(168 204 21 / 0.15),
      0 0 32px rgb(168 204 21 / 0.12);
  }

  .dep__topo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .dep__aspas {
    display: inline-block;
    font-family: var(--f-display);
    font-size: 5.5rem;
    line-height: 0.7;
    height: 0.5em;
    color: var(--lima);
    filter: var(--brilho);
  }
  .dep__selo {
    font-family: var(--f-display);
    font-size: 1.25rem;
    letter-spacing: 0.16em;
    color: var(--lima);
  }

  /* antes (dor, apagado) → virada → resultado (branco, sublinhado lima) */
  .dep__texto {
    margin: 0;
    flex: 1;
    font-size: var(--t-apoio);
    line-height: 1.6;
  }
  .dep__antes {
    color: var(--texto-2);
  }
  .dep__virada {
    color: var(--texto);
  }
  .dep__resultado {
    color: var(--branco);
    font-weight: 600;
    background: linear-gradient(var(--lima), var(--lima)) 0 100% / 100% 2px no-repeat;
    padding-bottom: 2px;
  }

  .dep__pessoa {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dep__foto {
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--lima);
    object-fit: cover;
  }
  .dep__foto--iniciais {
    display: grid;
    place-items: center;
    background: #1a1a1a;
    color: var(--lima);
    font-weight: 700;
    font-size: 1rem;
  }
  .dep__quem {
    display: grid;
    gap: 2px;
  }
  .dep__nome {
    color: var(--branco);
    font-weight: 700;
  }
  .dep__negocio {
    font-size: 0.875rem;
    color: var(--texto-2);
  }

  /* aviso de conteúdo provisório: chamativo de propósito, para não ir ao ar assim */
  /* modal do vídeo (vidro escuro, no estilo do site) */
  .video-modal {
    width: min(92vw, 420px, calc((94svh - 96px) * 9 / 16 + 28px));
    max-height: 94svh;
    margin: auto; /* centraliza (o reset global zera a margem do <dialog>) */
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--branco);
    overflow: visible;
  }
  .video-modal::backdrop {
    background: rgb(3 3 3 / 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .video-modal[open] {
    animation: modal-entra 0.35s var(--ease);
  }
  @keyframes modal-entra {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  .video-modal__caixa {
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 24px;
    border: 1px solid rgb(168 204 21 / 0.35);
    background: linear-gradient(160deg, rgb(20 22 16 / 0.92), rgb(6 7 5 / 0.96));
    box-shadow:
      0 0 60px rgb(168 204 21 / 0.18),
      0 30px 80px rgb(0 0 0 / 0.6);
  }
  .video-modal__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-left: 6px;
  }
  .video-modal__nome {
    font-family: var(--f-display);
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .video-modal__fechar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--linha);
    background: transparent;
    color: var(--branco);
    cursor: pointer;
  }
  .video-modal__fechar svg {
    width: 18px;
    height: 18px;
  }
  .video-modal__fechar:hover {
    border-color: var(--lima);
    color: var(--lima);
  }
  .video-modal__tela {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
  }
  .video-modal__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }
  .video-modal__carregando {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 3px solid rgb(168 204 21 / 0.25);
    border-top-color: var(--lima);
    animation: gira 0.8s linear infinite;
    pointer-events: none;
  }
  .video-modal__tela--pronta .video-modal__carregando,
  .video-modal__tela--pausado .video-modal__carregando {
    display: none;
  }
  .video-modal__play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 1px solid rgb(168 204 21 / 0.5);
    background: rgb(6 7 5 / 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--lima);
    cursor: pointer;
    opacity: 0;
    scale: 0.9;
    pointer-events: none;
    transition:
      opacity 0.25s var(--ease),
      scale 0.25s var(--ease);
  }
  .video-modal__play svg {
    width: 28px;
    height: 28px;
    margin-left: 3px;
  }
  .video-modal__tela--pausado .video-modal__play {
    opacity: 1;
    scale: 1;
    pointer-events: auto;
  }
  .video-modal__controles {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 36px 16px 14px;
    background: linear-gradient(to top, rgb(0 0 0 / 0.7), transparent);
  }
  /* progresso em linhas horizontais: traços curtos que acendem em lima conforme o vídeo avança */
  .video-modal__linhas {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    cursor: pointer;
    touch-action: none;
    border-radius: 4px;
  }
  .video-modal__linhas:focus-visible {
    outline: 2px solid var(--lima);
    outline-offset: 4px;
  }
  .video-modal__linhas span {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.28);
    transition:
      background-color 0.2s var(--ease),
      height 0.2s var(--ease);
  }
  .video-modal__linhas span.cheio {
    background: var(--lima);
    height: 3px;
  }
  .video-modal__linhas:hover span {
    height: 4px;
  }
  .video-modal__som {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--branco);
    cursor: pointer;
  }
  .video-modal__som svg {
    width: 22px;
    height: 22px;
  }
  .video-modal__som:hover {
    color: var(--lima);
  }
  .video-modal__mudo,
  .video-modal__tela--mudo .video-modal__onda {
    display: none;
  }
  .video-modal__tela--mudo .video-modal__mudo {
    display: inline;
  }
  @keyframes gira {
    to {
      rotate: 360deg;
    }
  }

  .dep__video {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(168 204 21 / 0.45);
    color: var(--lima);
    flex: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .dep__video:hover,
  .dep__video:focus-visible {
    background: var(--lima);
    color: #050505;
  }
  .dep__video svg {
    width: 18px;
    height: 18px;
    margin-left: 2px;
  }
  .dep__provisorio {
    position: absolute;
    top: -11px;
    left: 24px;
    padding: 2px 10px;
    border: 1px dashed #f5a524;
    border-radius: 999px;
    background: #1a1204;
    color: #f5a524;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* celular: carrossel com arraste (scroll-snap nativo, sem biblioteca) */
  @media (max-width: 900px) {
    .depoimentos__lista {
      display: flex;
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter);
      padding-block: 14px 8px;
      scrollbar-width: none;
    }
    .depoimentos__lista::-webkit-scrollbar {
      display: none;
    }
    .dep {
      flex: 0 0 min(86%, 380px);
      scroll-snap-align: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dep__corpo {
      transition: none;
    }
  }
</style>
