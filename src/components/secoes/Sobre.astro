---
/**
 * 05 · Sobre: humanizar. Palco animado (V2: veio da hero) + história + fatos. A foto dos fundadores foi para a hero.
 * Palco: os 2 capítulos do vídeo institucional se alternando (01 celular · 02 barras), MOTION.md §1.3.
 * Celular/tablet: no lugar do palco, o vídeo institucional num quadro igual aos cards de Resultados.
 * Motion: o palco se monta ao chegar na seção; título em texto cinético (CabecalhoSecao); parágrafos
 * entram do desfoque para a nitidez. Animação: src/scripts/anim-sobre.ts.
 * Sem JS ou com "reduzir movimento": capítulo 01 montado e parado, tudo visível.
 */
import CabecalhoSecao from "../ui/CabecalhoSecao.astro";
import PisoGrade from "../motion/PisoGrade.astro";
import CenaPosicionamento from "../motion/CenaPosicionamento.astro";
import CenaFaturamento from "../motion/CenaFaturamento.astro";
import { sobre } from "../../content/home";
---

<section id="sobre" class="sobre" data-sobre aria-labelledby="sobre-titulo">
  <PisoGrade horizonte={78} class="sobre__piso" />

  <div class="container sobre__grade">
    <!-- palco: capítulo 01 (celular) e 02 (barras) se alternando, como no vídeo (V2: veio da hero) -->
    <div class="sobre__cena palco" data-sobre-cena role="img" aria-label={sobre.cena.descricao}>
      <div class="palco__cenas">
        <CenaPosicionamento {...sobre.cena.posicionamento} />
        <CenaFaturamento {...sobre.cena.faturamento} />
        <div class="palco__clarao" data-palco-clarao aria-hidden="true"></div>
      </div>
    </div>

    <!-- celular: vídeo institucional no lugar do palco (quadro no estilo dos cards de Resultados) -->
    <figure class="sobre__video" data-sobre-video>
      <figcaption class="video__cap">
        <span class="video__ponto" aria-hidden="true"></span>
        <span>{sobre.video.rotulo}</span>
        <span class="video__trilho" aria-hidden="true"></span>
        <span class="video__duracao">{sobre.video.duracao}</span>
      </figcaption>
      <div class="video__tela">
        <video
          src={sobre.video.src}
          preload="none"
          playsinline
          aria-label={sobre.video.descricao}
          data-video
        ></video>
        <button
          class="video__capa"
          type="button"
          data-video-play
          aria-label={`Reproduzir: ${sobre.video.chamada}`}
        >
          <img src={sobre.video.capa} alt="" width="540" height="960" loading="lazy" decoding="async" />
          <span class="video__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
            </svg>
          </span>
          <span class="video__chamada">{sobre.video.chamada}</span>
        </button>
      </div>
    </figure>

    <div class="sobre__texto">
      <CabecalhoSecao id="sobre-titulo" sobretitulo={sobre.sobretitulo} {...sobre.titulo} />
      {sobre.paragrafos.map((p) => (
        <p class="sobre__p" data-sobre-p>
          {p}
        </p>
      ))}
      <ul class="sobre__fatos" role="list">
        {sobre.fatos.map((f) => (
          <li class="fato" data-sobre-fato>
            <span class="fato__valor">{f.valor}</span>
            <span class="fato__rotulo">{f.rotulo}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import "../../scripts/anim-sobre";

  // vídeo do celular: só carrega ao tocar no play (preload="none"); depois ficam os controles nativos
  const quadro = document.querySelector<HTMLElement>("[data-sobre-video]");
  const video = quadro?.querySelector<HTMLVideoElement>("[data-video]");
  const capa = quadro?.querySelector<HTMLButtonElement>("[data-video-play]");
  if (video && capa) {
    capa.addEventListener("click", () => {
      capa.hidden = true;
      video.controls = true;
      void video.play();
    });
  }
</script>

<style>
  .sobre {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--secao-respiro);
  }
  .sobre > :global(.sobre__piso) {
    z-index: -1;
    opacity: 0.35;
  }
  .sobre__grade {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(24px, 5vw, 80px);
  }

  /* palco: cenas empilhadas no mesmo lugar */
  .palco {
    display: grid;
    gap: clamp(8px, 2vh, 20px);
    width: 100%;
    max-width: 560px;
    justify-self: center;
  }
  .palco__cenas {
    position: relative;
    display: grid;
  }
  /* :global porque as cenas são outros componentes (o escopo do Astro não as alcança) */
  .palco__cenas > :global(*) {
    grid-area: 1 / 1;
  }
  /* sem JS, só o capítulo 01 aparece */
  .palco__cenas > :global([data-cap="1"]) {
    visibility: hidden;
  }
  /* clarão de troca de capítulo (como o film burn do vídeo) */
  .palco__clarao {
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      closest-side,
      rgb(200 240 58 / 0.55),
      rgb(168 204 21 / 0.12) 60%,
      transparent
    );
    mix-blend-mode: screen;
  }

  /* vídeo institucional: só no celular/tablet. Quadro igual ao card de Resultados */
  .sobre__video {
    display: none;
    gap: 14px;
    width: 100%;
    max-width: 400px;
    justify-self: center;
    padding: 14px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 20px;
    background:
      radial-gradient(120% 70% at 50% 0%, rgb(168 204 21 / 0.07), transparent 70%), rgb(255 255 255 / 0.015);
  }
  .video__cap {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto);
  }
  .video__ponto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lima);
    box-shadow: 0 0 10px var(--lima);
  }
  .video__trilho {
    flex: 1;
    height: 1px;
    background: rgb(255 255 255 / 0.12);
  }
  .video__duracao {
    color: var(--texto-2);
    font-variant-numeric: tabular-nums;
  }
  .video__tela {
    position: relative;
    display: grid;
    aspect-ratio: 9 / 16;
    width: min(100%, 72svh * 9 / 16); /* largura fixa: não muda quando o vídeo carrega */
    margin-inline: auto;
    overflow: hidden;
    border-radius: 12px;
    background: #000;
  }
  .video__tela > * {
    grid-area: 1 / 1;
  }
  .video__tela video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__capa {
    position: relative;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
  }
  .video__capa[hidden] {
    display: none;
  }
  .video__capa img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__capa::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(3 3 3 / 0.85), transparent 45%);
  }
  .video__play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--lima);
    color: var(--bg);
    box-shadow: 0 0 0 8px rgb(168 204 21 / 0.18);
    transition: transform 0.25s var(--ease);
  }
  .video__capa:hover .video__play,
  .video__capa:focus-visible .video__play {
    transform: scale(1.06);
  }
  .video__chamada {
    position: absolute;
    z-index: 1;
    inset: auto 16px 16px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--branco);
    text-align: center;
  }

  /* texto */
  .sobre__texto {
    display: grid;
    gap: 22px;
  }
  /* aqui o título já tem o texto colado: menos respiro que nas seções com cards */
  .sobre__texto :global(.cabecalho) {
    margin-bottom: 4px;
  }
  .sobre__p {
    font-size: var(--t-apoio);
    line-height: 1.7;
    max-width: 52ch;
  }
  .sobre__fatos {
    list-style: none;
    padding: 0;
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--linha);
  }
  .fato {
    display: grid;
    gap: 4px;
    padding: 18px 16px 0 0;
  }
  .fato + .fato {
    padding-left: 18px;
    border-left: 1px solid var(--linha);
  }
  .fato__valor {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.125rem);
    line-height: 1;
    color: var(--lima);
    letter-spacing: 0.01em;
  }
  .fato__rotulo {
    font-size: 0.875rem;
    color: var(--texto);
  }

  @media (max-width: 900px) {
    .sobre__grade {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    /* celular/tablet: sem o palco animado; entra o vídeo */
    .sobre__cena {
      display: none;
    }
    .sobre__video {
      display: grid;
    }
    .sobre__texto {
      text-align: left;
    }
  }
  @media (max-width: 520px) {
    .sobre__fatos {
      grid-template-columns: 1fr;
    }
    .fato,
    .fato + .fato {
      padding: 14px 0;
      border-left: 0;
      border-bottom: 1px solid var(--linha);
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 12px;
    }
  }
</style>
