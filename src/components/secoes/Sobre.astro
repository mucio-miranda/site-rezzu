---
/**
 * 05 · Sobre: humanizar. Foto dos fundadores (recorte tratado no Photoshop) + história + fatos.
 * Foto: gerada com IA a partir da foto do ensaio (prompt em SITE/ASSETS/prompts-ia/fundadores-sobre.md), luz lima da esquerda,
 * recortada no Photoshop (Selecionar assunto).
 * Motion (ARQUITETURA.md §6): o facho de luz da esquerda acende e a foto sai do escuro;
 * parallax leve da foto em relação ao texto; título em texto cinético (CabecalhoSecao); parágrafos
 * entram do desfoque para a nitidez. Animação: src/scripts/anim-sobre.ts.
 * Sem JS ou com "reduzir movimento": tudo visível e parado.
 */
import { Image } from "astro:assets";
import CabecalhoSecao from "../ui/CabecalhoSecao.astro";
import PisoGrade from "../motion/PisoGrade.astro";
import foto from "../../assets/fundadores/fundadores-ia.webp";
// PNG de 16 cores (59 KB): o meio-tom em pontos fica 3x mais leve que em WebP
import fundoZ from "../../assets/fundadores/fundo-z-meio-tom.png";
import { sobre } from "../../content/home";
---

<section id="sobre" class="sobre" data-sobre aria-labelledby="sobre-titulo">
  <PisoGrade horizonte={78} class="sobre__piso" />
  <!-- luz lima vinda da esquerda: ocupa a seção toda e acompanha a largura da tela -->
  <span class="sobre__luz" data-sobre-luz aria-hidden="true"></span>

  <div class="container sobre__grade">
    <figure class="sobre__foto" data-sobre-foto>
      <!-- fundo de baixa opacidade: o Z da marca em meio-tom, atrás dos fundadores -->
      <img
        class="sobre__fundo"
        src={fundoZ.src}
        width={fundoZ.width}
        height={fundoZ.height}
        alt=""
        decoding="async"
        data-sobre-fundo
      />
      <div class="sobre__img" data-sobre-img>
        <Image
          src={foto}
          alt={sobre.altFoto}
          widths={[420, 640, 900, 1024]}
          sizes="(max-width: 900px) 92vw, min(600px, 44vw)"
          loading="eager"
          fetchpriority="low"
          quality={78}
        />
      </div>
      <!-- label flutuante em vidro, com a luz lima da esquerda batendo na borda -->
      <figcaption class="sobre__legenda" data-sobre-legenda>
        <span class="legenda__ponto" aria-hidden="true"></span>
        <span class="legenda__texto">{sobre.legendaFoto}</span>
      </figcaption>
    </figure>

    <div class="sobre__texto">
      <CabecalhoSecao id="sobre-titulo" sobretitulo={sobre.sobretitulo} {...sobre.titulo} />
      {sobre.paragrafos.map((p) => (
        <p class="sobre__p" data-sobre-p>
          {p}
        </p>
      ))}
      <ul class="sobre__fatos" role="list">
        {sobre.fatos.map((f) => (
          <li class="fato" data-sobre-fato>
            <span class="fato__valor">{f.valor}</span>
            <span class="fato__rotulo">{f.rotulo}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import "../../scripts/anim-sobre";
</script>

<style>
  .sobre {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--secao-respiro);
  }
  .sobre > :global(.sobre__piso) {
    z-index: -1;
    opacity: 0.35;
  }
  .sobre__grade {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(24px, 5vw, 80px);
  }

  /* foto: recorte com luz lima atrás (a "rim light" do vídeo) */
  .sobre__foto {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
  }
  /* Z da marca em meio-tom, atrás dos fundadores, do tamanho da foto */
  .sobre__fundo {
    position: absolute;
    left: 50%;
    top: 48%;
    width: auto;
    height: 96%;
    max-width: none;
    translate: -50% -50%;
    opacity: 0.2;
    pointer-events: none;
    /* bordas somem: sem o retângulo de pontos aparente */
    mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
  }
  /* luz lima (cor da marca) vindo da borda esquerda da tela: tamanho em vw para escalar do notebook ao
     ultrawide, e some suave em todas as direções (sem corte na borda da seção nem da foto) */
  .sobre__luz {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse min(62vw, 1100px) 70% at 0% 46%,
        rgb(168 204 21 / 0.2),
        rgb(168 204 21 / 0.07) 45%,
        transparent 75%
      ),
      radial-gradient(ellipse min(30vw, 520px) 40% at 0% 42%, rgb(168 204 21 / 0.16), transparent 70%);
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    transform-origin: 0 46%;
  }
  .sobre__img {
    position: relative;
    width: min(100%, 600px);
    /* corta embaixo com degradê: os fundadores "saem" do fundo */
    /* embaixo: pernas fundem no fundo; à esquerda: suaviza o notebook, que está cortado na foto original */
    mask-image: linear-gradient(to bottom, #000 74%, transparent 98%);
  }
  .sobre__img :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .sobre__legenda {
    position: absolute;
    z-index: 2;
    /* centralizada com a foto dos fundadores */
    left: 50%;
    translate: -50% 0;
    bottom: 13%;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 14px;
    border-radius: 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--branco);
    /* vidro: fundo translúcido + desfoque do que está atrás */
    background:
      linear-gradient(105deg, rgb(168 204 21 / 0.22), rgb(168 204 21 / 0.04) 38%, transparent 60%),
      linear-gradient(160deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.03));
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-left-color: rgb(168 204 21 / 0.7); /* a luz da esquerda bate na borda */
    box-shadow:
      -6px 0 24px -8px rgb(168 204 21 / 0.55),
      inset 1px 1px 0 rgb(255 255 255 / 0.18),
      0 18px 40px rgb(0 0 0 / 0.45);
  }
  .legenda__ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lima);
    box-shadow: 0 0 10px var(--lima);
    flex: none;
  }

  /* texto */
  .sobre__texto {
    display: grid;
    gap: 22px;
  }
  /* aqui o título já tem o texto colado: menos respiro que nas seções com cards */
  .sobre__texto :global(.cabecalho) {
    margin-bottom: 4px;
  }
  .sobre__p {
    font-size: var(--t-apoio);
    line-height: 1.7;
    max-width: 52ch;
  }
  .sobre__fatos {
    list-style: none;
    padding: 0;
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--linha);
  }
  .fato {
    display: grid;
    gap: 4px;
    padding: 18px 16px 0 0;
  }
  .fato + .fato {
    padding-left: 18px;
    border-left: 1px solid var(--linha);
  }
  .fato__valor {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 1.1rem + 1vw, 2.125rem);
    line-height: 1;
    color: var(--lima);
    letter-spacing: 0.01em;
  }
  .fato__rotulo {
    font-size: 0.875rem;
    color: var(--texto);
  }

  @media (max-width: 900px) {
    .sobre__grade {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .sobre__img {
      width: min(92%, 460px);
    }
    .sobre__legenda {
      bottom: 10%;
      font-size: 0.75rem;
    }
    .sobre__texto {
      text-align: left;
    }
  }
  @media (max-width: 520px) {
    .sobre__fatos {
      grid-template-columns: 1fr;
    }
    .fato,
    .fato + .fato {
      padding: 14px 0;
      border-left: 0;
      border-bottom: 1px solid var(--linha);
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 12px;
    }
  }
</style>
