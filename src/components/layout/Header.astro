---
/** Header fixo: transparente sobre a hero, ganha fundo desfocado ao rolar. Menu vira gaveta no mobile. */
import LogoRezzu from "../ui/LogoRezzu.astro";
import Botao from "../ui/Botao.astro";
import { navegacao, ctaPrincipal } from "../../content/home";
---

<header class="header" data-header>
  <div class="header__barra container">
    <a href="/" class="header__marca" aria-label="REZZU group, início">
      <LogoRezzu altura={26} title="REZZU" />
    </a>

    <nav class="header__nav" id="menu-principal" aria-label="Principal">
      <ul>
        {navegacao.map((item) => (
          <li>
            <a href={item.href}>{item.rotulo}</a>
          </li>
        ))}
      </ul>
      <Botao href={ctaPrincipal.href} evento="clique_cta" seta={false} class="header__cta-mobile">
        {ctaPrincipal.rotulo}
      </Botao>
    </nav>

    <Botao href={ctaPrincipal.href} evento="clique_cta" seta={false} class="header__cta">
      {ctaPrincipal.rotulo}
    </Botao>

    <button class="header__menu" type="button" aria-expanded="false" aria-controls="menu-principal" data-menu>
      <span class="sr-only">Abrir menu</span>
      <span class="header__menu-linha header__menu-linha--a"></span>
      <span class="header__menu-linha header__menu-linha--b"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const botao = document.querySelector<HTMLButtonElement>("[data-menu]");
  if (header) {
    const marcar = () => header.classList.toggle("header--rolado", window.scrollY > 24);
    marcar();
    window.addEventListener("scroll", marcar, { passive: true });
  }
  if (header && botao) {
    const fechar = () => {
      header.classList.remove("header--aberto");
      botao.setAttribute("aria-expanded", "false");
    };
    botao.addEventListener("click", () => {
      const aberto = header.classList.toggle("header--aberto");
      botao.setAttribute("aria-expanded", String(aberto));
    });
    header.querySelectorAll("nav a").forEach((a) => a.addEventListener("click", fechar));
    document.addEventListener("keydown", (e) => e.key === "Escape" && fechar());
  }
</script>

<style>
  /* teste (19/10/2026): navbar em pílula flutuante, com a largura do conteúdo (.container) */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-top: 14px;
    pointer-events: none; /* só a pílula recebe clique */
  }
  .header__barra {
    pointer-events: auto;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
    padding: 0 10px 0 28px;
    border-radius: 999px;
  }
  /* o vidro fica numa camada atrás da pílula: um backdrop-filter na própria barra viraria o "contêiner" da
     gaveta fixa do celular e a deslocaria */
  .header__barra::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(3 3 3 / 0.2);
    transition:
      background-color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .header--rolado .header__barra::before,
  .header--aberto .header__barra::before {
    /* vidro fosco: blur forte e fundo translúcido para o desfoque aparecer */
    background: rgb(3 3 3 / 0.55);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    backdrop-filter: blur(28px) saturate(160%);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.45);
  }
  .header__marca {
    display: flex;
    align-items: center;
    color: var(--branco);
  }
  .header__nav {
    display: flex;
    align-items: center;
  }
  .header__nav ul {
    display: flex;
    gap: 40px;
    list-style: none;
    padding: 0;
  }
  .header__nav a:not(.botao) {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--texto);
    transition: color 0.2s var(--ease);
  }
  .header__nav a:not(.botao):hover {
    color: var(--branco);
  }
  /* seletores com o pai (.header__barra/.header__nav) para vencer o estilo do componente Botao */
  .header__nav :global(.header__cta-mobile),
  .header__menu {
    display: none;
  }
  .header__barra :global(.header__cta) {
    padding: 14px 24px;
    font-size: 0.9375rem;
  }

  @media (max-width: 960px) {
    .header__barra {
      height: 60px;
      padding: 0 8px 0 22px;
    }
    .header__barra :global(.header__cta) {
      display: none;
    }
    .header__menu {
      display: grid;
      gap: 6px;
      place-content: center;
      width: 44px;
      height: 44px;
      background: none;
      border: 1px solid var(--linha);
      border-radius: 999px;
      cursor: pointer;
    }
    .header__menu-linha {
      width: 20px;
      height: 2px;
      background: var(--branco);
      transition:
        transform 0.35s var(--ease),
        background-color 0.35s var(--ease);
    }
    /* aberto: o X do logo. A diagonal do Z (branca, /, ~49°) passa por cima da lâmina (lima, \, ~38°) */
    .header__menu-linha--a {
      position: relative;
      z-index: 1;
    }
    .header--aberto .header__menu-linha--a {
      transform: translateY(4px) rotate(-49deg);
      box-shadow: 0 0 0 1.5px var(--bg); /* recorte na lâmina, como no logo */
    }
    .header--aberto .header__menu-linha--b {
      transform: translateY(-4px) rotate(38deg);
      background: var(--lima);
    }
    .header__nav {
      position: fixed;
      /* gaveta abaixo da pílula, com a mesma largura e cantos arredondados */
      top: 86px;
      left: 50%;
      width: min(100% - 2 * var(--gutter), var(--container));
      border-radius: 28px;
      border: 1px solid var(--linha);
      display: grid;
      justify-items: start;
      gap: 28px;
      padding: 32px var(--gutter) 40px;
      background: rgb(3 3 3 / 0.96);
      -webkit-backdrop-filter: blur(28px) saturate(160%);
      backdrop-filter: blur(28px) saturate(160%);
      transform: translate(-50%, -8px); /* centraliza e começa um pouco acima */
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.3s var(--ease),
        transform 0.3s var(--ease),
        visibility 0.3s;
    }
    .header--aberto .header__nav {
      transform: translate(-50%, 0);
      opacity: 1;
      visibility: visible;
    }
    .header__nav ul {
      flex-direction: column;
      gap: 20px;
    }
    .header__nav a:not(.botao) {
      font-size: 1.25rem;
      color: var(--branco);
    }
    .header__nav :global(.header__cta-mobile) {
      display: inline-flex;
    }
  }
</style>
