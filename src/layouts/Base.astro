---
/**
 * Layout base: <head> com SEO, fontes auto-hospedadas e estilos globais.
 * Header, rodapé, banner LGPD e rastreamento entram nas próximas fases (ARQUITETURA.md §14).
 */
import "@fontsource/bebas-neue/400.css";
import "@fontsource-variable/montserrat";
import "../styles/global.css";
import { site } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  /** imagem de compartilhamento em /public/og/ (1200x630) */
  og?: string;
  /** texto alternativo da imagem de compartilhamento */
  ogAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.descricao,
  og = "/og/padrao.jpg",
  ogAlt = site.ogAlt,
  noindex = false,
} = Astro.props;
const tituloCompleto = title
  ? `${title} | ${site.nome}`
  : `${site.nome} · Assessoria de marketing em ${site.cidade}`;
// build em formato "file": a home sai como /index.html e as páginas como /med.html; o endereço público não tem .html
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
// Proxima Nova (licença web via Adobe Fonts). Vazio = usa a fonte local/Montserrat.
const adobeKit = import.meta.env.PUBLIC_ADOBE_FONTS_KIT;
const ogUrl = new URL(og, Astro.site);
// dados estruturados (schema.org): a REZZU como empresa local. Só dados confirmados; os PENDENTES ficam de fora
const sameAs = Object.values(site.redes).filter(Boolean);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.nome,
  description: site.descricao,
  url: new URL("/", Astro.site).href,
  logo: new URL("/marca/rezzu-logo.png", Astro.site).href,
  image: ogUrl.href,
  areaServed: `${site.cidade}, ${site.uf}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.cidade,
    addressRegion: site.uf,
    addressCountry: "BR",
  },
  ...(site.contato.email ? { email: site.contato.email } : {}),
  ...(site.contato.whatsapp ? { telephone: `+${site.contato.whatsapp}` } : {}),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#030303" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="author" content={site.nome} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {adobeKit && (
      <>
        <link rel="preconnect" href="https://use.typekit.net" crossorigin />
        <link rel="stylesheet" href={`https://use.typekit.net/${adobeKit}.css`} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    {site.metaVerificacao && <meta name="facebook-domain-verification" content={site.metaVerificacao} />}

    <!-- Animações: esconde os elementos animáveis só se a animação vai rodar; destrava sozinho em 3 s se o JS falhar -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          h.classList.add("anim-espera");
          setTimeout(function () {
            h.classList.remove("anim-espera");
          }, 3000);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
