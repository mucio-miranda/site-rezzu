# Modelo de variáveis de ambiente. NÃO coloque valores reais aqui.
# Em produção, crie as variáveis no Netlify: Site configuration > Environment variables (e faça um novo deploy).
# Variáveis vazias = recurso desligado (o script nem é carregado). Ver ARQUITETURA.md §7.1.

# URL pública final (quando houver domínio). Sem ela, o Netlify usa a URL do site automaticamente.
SITE_URL=

# --- Rastreamento (só carrega após consentimento LGPD) ---
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LABEL_LEAD=
PUBLIC_GOOGLE_ADS_LABEL_WHATSAPP=
PUBLIC_GA4_ID=
